* =========================================================
   BACKGROUND VIDEO
   ========================================================= */
.video {
    position: relative;
    width: 100%;
    min-height: 142.68vh;
    overflow: hidden;
}

#bg-video {
    position: fixed;
    top: 0;
    left: 0;
    width: 142.68vw;
    height: 142.68vh;
    object-fit: cover;
    z-index: -9999;
    pointer-events: none;
}