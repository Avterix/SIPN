{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(assets|background|dashboard|elements|gif|icons|webref)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/(auth-edtech\\.css|dashboard-bento\\.css|profile\\.css|rapor\\.css|style1\\.css|auth-style\\.css|auth-style2\\.css|auth-style3\\.css|animasi-sipn\\.css|auth\\.js)",
      "dest": "/$1"
    },
    {
      "src": "/maintenance.html",
      "dest": "/maintenance.html"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}